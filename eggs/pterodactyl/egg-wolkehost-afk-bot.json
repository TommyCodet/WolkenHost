{
  "_comment": "WolkeHost AFK Bot egg. Variables are read directly by bot.js.",
  "meta": {
    "version": "PTDL_v2",
    "update_url": null
  },
  "exported_at": "2026-11-16T00:00:00+00:00",
  "name": "WolkeHost AFK Bot",
  "author": "support@wolkehost.local",
  "description": "Minecraft Java AFK bot powered by Mineflayer. Uses Mineflayer's Microsoft device login.",
  "features": [],
  "docker_images": {
    "Node.js 20": "ghcr.io/parkervcp/yolks:nodejs_20"
  },
  "file_denylist": [],
  "startup": "node /home/container/bot.js",
  "config": {
    "files": "{}",
    "startup": "{\"done\":\"Minecraft login event received\"}",
    "logs": "{}",
    "stop": "^C"
  },
  "scripts": {
    "installation": {
      "script": "#!/bin/bash\nset -euo pipefail\ncd /mnt/server\ncurl -fsSL https://raw.githubusercontent.com/TommyCodet/WolkenHost/main/bot.js -o /mnt/server/bot.js\nnpm init -y\nnpm install --omit=dev --no-audit --no-fund mineflayer@^4.25.0\n",
      "container": "node:20-bookworm-slim",
      "entrypoint": "bash"
    }
  },
  "variables": [
    {
      "name": "Minecraft Server Host",
      "description": "Public DNS name or public IP of the Minecraft Java server.",
      "env_variable": "SERVER_HOST",
      "default_value": "play.example.net",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|max:253"
    },
    {
      "name": "Minecraft Server Port",
      "description": "Minecraft Java server TCP port.",
      "env_variable": "SERVER_PORT",
      "default_value": "25565",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|integer|min:1|max:65535"
    },
    {
      "name": "Minecraft Version",
      "description": "Use auto or a version supported by WolkeHost.",
      "env_variable": "MC_VERSION",
      "default_value": "auto",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|in:auto,1.21.1,1.20.4,1.19.4"
    },
    {
      "name": "Send AFK Command",
      "description": "Send AFK_COMMAND after login.",
      "env_variable": "AFK_ENABLED",
      "default_value": "true",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|boolean"
    },
    {
      "name": "AFK Command",
      "description": "Command sent after successful login if enabled.",
      "env_variable": "AFK_COMMAND",
      "default_value": "/afk on",
      "user_viewable": true,
      "user_editable": false,
      "rules": "nullable|string|max:100"
    },
    {
      "name": "Automatic Reconnect",
      "description": "Reconnect when the connection ends.",
      "env_variable": "AUTO_RECONNECT",
      "default_value": "true",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|boolean"
    },
    {
      "name": "Reconnect Delay (seconds)",
      "description": "Reconnect delay; worker clamps values to 5–300 seconds.",
      "env_variable": "RECONNECT_DELAY",
      "default_value": "10",
      "user_viewable": true,
      "user_editable": false,
      "rules": "required|integer|min:5|max:300"
    }
  ]
}